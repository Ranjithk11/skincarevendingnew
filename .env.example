# ==============================================================================
# Leafwater Skincare Vending Machine - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in the values.

# ---------- Leafwater Backend ----------
#NEXT_PUBLIC_API_URL=http://103.131.196.202:8000
NEXT_PUBLIC_API_URL=https://backend.leafwater.in:8001

# Location-wise landing page image (Make.com Image Retrieval API)
# GET ?location=GMR-AIRPORT-M4 | T-HUB | STUDIO | RAINBOWVISTA | COMMON (if configured)
LANDING_IMAGE_API_URL=https://hook.eu1.make.com/ovrqvu3wcqb6qoi5znlx7dy8q2wm628g

# ---------- NextAuth ----------
NEXT_PUBLIC_AUTH_SECRET=your-auth-secret-here

# ---------- Site URL (for QR codes) ----------
NEXT_PUBLIC_SITE_URL=https://skincarevendingnew.vercel.app

# ---------- PostHog Analytics ----------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------- Flask API ----------
FLASK_SECRET_KEY=
FLASK_DEBUG=true
FLASK_API_URL=http://localhost:5000
NEXT_PUBLIC_FLASK_API_URL=http://localhost:5000

# ---------- SQLite Database ----------
SQLITE_DB_PATH=instance/leafwater.db

# ---------- Razorpay ----------
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=

# ---------- STM32 Motor Controller ----------
STM32_PORT=COM3
STM32_MOCK=false
STM32_BAUDRATE=115200
STM32_TIMEOUT_MS=300000
STM32_DELAY_BETWEEN_COMMANDS_MS=2000
STM32_DELAY_BEFORE_FINALIZE_MS=3000
STM32_FINALIZE_MODE=once
STM32_SLOT_ID_OFFSET=-1
STM32_AUTO_TRAY_AFTER_SINGLE=true
STM32_TRAY_BATCH_SIZE=2

# ---------- POSIFLY POS Integration ----------
POSIFLY_API_URL=
POSIFLY_API_KEY=
POSIFLY_OUTLET_REF_ID=LEAFWATER_001
POSIFLY_POS_TERMINAL_ID=VENDING_01

# ---------- LW Analytics Backend (FastAPI at localhost:8000) ----------
# Base URL of the analytics backend
LW_ANALYTICS_URL=http://localhost:8000

# JWT login credentials for dashboard APIs
LW_ANALYTICS_USERNAME=admin
LW_ANALYTICS_PASSWORD=

# Machine identity (must match a registered machine in the analytics backend)
LW_MACHINE_ID=LW-VM-Floor1
LW_MACHINE_NAME=LW VM Floor 1
LW_MACHINE_LOCATION=Floor 1

# X-API-Key for machine-facing endpoints (/posifly/*, /sync, /machines/heartbeat)
LW_MACHINE_API_KEY=

# ---------- Make.com Webhooks ----------
# Primary scan-completed webhook (user notification flow)
NEXT_PUBLIC_SCAN_COMPLETED_WEBHOOK_URL=https://hook.eu1.make.com/2jsb7s7vin1sohcbdc0ttfv31p9mofhu
# Secondary scan-completed webhook (full analysis payload)
NEXT_PUBLIC_SCAN_COMPLETED_WEBHOOK_URL_2=https://hook.eu1.make.com/mnjehjt01i8p52qh78dzdx3i6crgyivt

# Invoice email webhook (Make.com sends tax invoice PDF/email after checkout)
INVOICE_EMAIL_WEBHOOK_URL=https://hook.eu1.make.com/g8odvmr2rp4er2n63dhmo3ku3uqbi4nu

# Dispense failure webhook (Make.com alert when product does not dispense)
NEXT_PUBLIC_DISPENSE_ERROR_WEBHOOK_URL=https://hook.eu1.make.com/lsphkpfoosnyvhvjew1a180q3oi6c645

# Dispense success webhook (fires only when motor + tray complete OK)
NEXT_PUBLIC_DISPENSE_WEBHOOK_URL=https://hook.eu1.make.com/bel61vvl1lpvleljhuzpyc5osor8fnz3

# Payment success webhook (fires on /feedback after checkout)
NEXT_PUBLIC_PAYMENT_WEBHOOK_URL=https://hook.eu1.make.com/q38x43z4ddv0x654fedj5n661ls8pvig

# Slot / product inventory update webhook (admin slot changes)
NEXT_PUBLIC_SLOT_UPDATE_WEBHOOK_URL=https://hook.eu1.make.com/2g5m8urqau04sgnynlxk4i7cdvjgdmoc

# Free consultation lead webhook (consultation popup on report page)
NEXT_PUBLIC_CONSULTATION_WEBHOOK_URL=https://hook.eu1.make.com/l35iie6ib0pdzol0hlv7jztdeonumrkg

# Birthday spin-wheel offer lead webhook (name, phone, date of birth)
NEXT_PUBLIC_BIRTHDAY_OFFER_WEBHOOK_URL=https://hook.eu1.make.com/gimljdauory9hjmmh3tzp8jotqwq67jd

# ---------- Staff QR cash authorization (QRAUTH) ----------
# Make.com webhook — POST { "hash": "..." }
# Success: { success: true, data: { staffname: "Name|Phone|Branch" } }
# Failure: { success: false, code: 400, message: "QR Code not found", data: null }
STAFF_QR_VERIFY_URL=https://hook.eu1.make.com/57gbgavipbzvqczkur4lqckoj69u6mos
# Optional API key / Bearer token (not required for the Make hook above)
STAFF_QR_VERIFY_API_KEY=
# Set to 1 for local UI testing without an upstream API (returns Demo Staff)
STAFF_QR_DEV_MOCK=0
